# Copy to .env for local development. Never commit .env.
# On Vercel / Netlify, set these in the project's Environment Variables instead.

# --- Public (shipped to the browser by scripts/build.mjs) ---
# Supabase > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / publishable key. It is safe in the browser because Row Level Security protects the data.
SUPABASE_ANON_KEY=your-anon-key
# Public site address (no trailing slash): canonical links, share image, sitemap
SITE_URL=https://your-domain.com
# Shown in the footer and the privacy/terms pages
SUPPORT_EMAIL=support@your-domain.com
# Plausible analytics: the site domain as added in Plausible (leave empty to turn analytics off)
PLAUSIBLE_DOMAIN=your-domain.com
# Only if you self-host Plausible or use a proxied script URL
PLAUSIBLE_SRC=

# --- Server-only: Supabase Edge Function secrets ---
# Set with: npx supabase secrets set --env-file supabase/.env.functions   (or one at a time)
# Never put these in Vercel/Netlify env vars, and never commit them.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to functions automatically.

# Resend > API Keys (sending access is enough)
RESEND_API_KEY=re_xxxxxxxx
# Sender address on a domain verified in Resend. Clients see "<Photographer name> <this address>".
REMINDER_FROM_EMAIL=reminders@mail.your-domain.com
# Public site URL, used for the "Stop reminders" link
APP_URL=https://your-domain.com
# Long random string shared by pg_cron and send-reminders (e.g. `openssl rand -hex 32`).
# Also store it in Vault as 'cron_secret' (see README).
CRON_SECRET=change-me

# Stripe (Developers > API keys; use test keys sk_test_... until launch)
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# Developers > Webhooks > your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# Product catalog > ShutterPaid Pro > the two prices ($9/month, $90/year)
STRIPE_PRICE_MONTHLY=price_xxxxxxxx
STRIPE_PRICE_YEARLY=price_xxxxxxxx
