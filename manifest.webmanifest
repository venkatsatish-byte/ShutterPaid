{
  "name": "ShutterPaid — Invoice reminders for photographers",
  "short_name": "ShutterPaid",
  "description": "Track photography invoices and send friendly payment reminders.",
  "start_url": "app.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f1020",
  "theme_color": "#0f1020",
  "orientation": "any",
  "categories": ["business", "finance", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "New invoice", "url": "app.html#new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
