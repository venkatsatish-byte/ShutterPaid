# Copy to .env for local development. Never commit .env.
# On Vercel / Netlify, set these in the project's Environment Variables instead.

# --- Public (shipped to the browser by scripts/build.mjs) ---
# Supabase > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / publishable key. It is safe in the browser because Row Level Security protects the data.
SUPABASE_ANON_KEY=your-anon-key

# --- Server-only (set with `supabase secrets set`, used by Edge Functions in later phases) ---
# Never put these in Vercel/Netlify env vars that reach the browser, and never commit them.
# RESEND_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
